# Cabeceras para Cloudflare Pages.
# Cachea los recursos estáticos con fuerza; el HTML siempre fresco.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# La versión va en la ruta (/vendor/three-0.160.0/), así que subir de versión
# cambia la URL: nunca hay que invalidar esta caché.
# consent.js no tiene versión en la ruta: la lleva en la query
# (/vendor/consent.js?v=AAAAMMDD) y hay que subirla en TODAS las páginas cada
# vez que cambie. Sin eso, Cloudflare y los navegadores siguen sirviendo la
# copia vieja hasta un año (el 15-sep-2026 el borde daba la del 8-ago).
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/screenshots/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/negocios/fuentes/*
  Cache-Control: public, max-age=31536000, immutable

/negocios/og*.png
  Cache-Control: public, max-age=604800

/negocios/precios/img/*
  Cache-Control: public, max-age=604800

# Identidad de marca: los ficheros llevan nombre estable, se cachean una semana.
/brand/*
  Cache-Control: public, max-age=604800

# Algunos hosts no adivinan el tipo del manifest y el navegador lo descarta.
/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
